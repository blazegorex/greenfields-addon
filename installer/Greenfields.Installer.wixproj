<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- The Greenfields installer (GreenfieldsSetup.msi). Build it with:  python tools/build_msi.py
       That stages the addon and updater exactly as the release zips have them, then runs
       `dotnet build` on this project. WiX v5 comes from NuGet; the only thing to install is the
       .NET SDK (see installer/README.md). -->
  <PropertyGroup>
    <OutputName>GreenfieldsSetup</OutputName>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
    <Cultures>en-US</Cultures>
    <GfVersion Condition="'$(GfVersion)' == ''">0.0.1</GfVersion>
    <GfStage Condition="'$(GfStage)' == ''">$(GfBuildRoot)stage\</GfStage>
    <GfHelpUrl Condition="'$(GfHelpUrl)' == ''">https://github.com/blazegorex/greenfields-addon</GfHelpUrl>
    <DefineConstants>Version=$(GfVersion);AddonSrc=$(GfStage)addon;UpdaterSrc=$(GfStage)updater;ArtDir=$(MSBuildProjectDirectory)\art;HelpUrl=$(GfHelpUrl)</DefineConstants>
    <!-- Expected, on purpose:
         ICE40  REINSTALLMODE is set (every file is always copied: a clean Greenfields folder)
         ICE61  same-version upgrades are allowed (a rebuilt installer replaces the old one)
         ICE91  the updater goes in the user's own AppData (the package is per-user only) -->
    <SuppressIces>ICE40;ICE61;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <ProjectReference Include="GreenfieldsCA\GreenfieldsCA.csproj" />
  </ItemGroup>
</Project>
