<Project Sdk="Microsoft.NET.Sdk">
  <!-- Custom actions for the Greenfields installer: find WoW, check nothing holds the
       Greenfields folder, turn auto updates on/off. Built by tools/build_msi.py (via the
       installer project); the output GreenfieldsCA.CA.dll is embedded in the MSI. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
  </ItemGroup>
</Project>
